[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[init]
	defaultBranch = "main"

[core]
	autoCRLF = false
	quotepath = false
	pager = delta
	preloadindex = true
	fscache = true
	editor = vim

[interactive]
	diffFilter = delta --color-only

[diff]
	algorithm = histogram
	colorMoved = plain
	renames = true
	mnemonicPrefix = true

[merge]
	conflictstyle = zdiff3

[user]
	name = "Takayuki Uchida"
	email = jacobitebeerlove@gmail.com

[color]
	ui = true

[push]
	default = simple
	followTags = true

[fetch]
	prune = true
	pruneTags = true
	all = true

[alias]
	l   = log --graph --date-order --date=format:'%Y/%m/%d %H:%M:%S' --pretty=format:'%Cred%h%Creset - %Cgreen[%cd]%Creset %C(bold blue)<%an>%Creset %C(yellow)%d%Creset %s'
	la  = l --all
	lf  = l       --first-parent
	lfa = l --all --first-parent

[credential]
	helper = store

[delta]
    side-by-side = true
    features = unobtrusive-line-numbers decorations
    whitespace-error-style = 22 reverse

[delta "unobtrusive-line-numbers"]
    line-numbers = true
    line-numbers-minus-style = "#444444"
    line-numbers-zero-style = "#444444"
    line-numbers-plus-style = "#444444"
    line-numbers-left-format = "{nm:>4}┊"
    line-numbers-right-format = "{np:>4}│"
    line-numbers-left-style = blue
    line-numbers-right-style = blue

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none
    hunk-header-decoration-style = yellow box

[ghq]
	root = ~/projects
